{
  "name": "@tibia.sh/tibiawiki-mcp",
  "version": "0.4.0",
  "description": "Offline MCP server for TibiaWiki: attribute queries over creatures, items, NPCs, quests and spells",
  "type": "module",
  "license": "MIT",
  "homepage": "https://tibia.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tibia-sh/tibiawiki-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tibia-sh/tibiawiki-mcp/issues"
  },
  "mcpName": "sh.tibia/tibiawiki-mcp",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.4.1",
  "bin": {
    "tibiawiki-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data/spell-areas.json",
    "data/tibiawikisql-requirements.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm typecheck && pnpm build && node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/min-tests.ts --test-reporter-destination=stderr test/*.test.ts",
    "decode-spell-areas": "node scripts/decode-spell-areas.ts",
    "lock-generator": "node scripts/lock-generator.ts",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@tibia.sh/tibiawiki-data": "^3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
